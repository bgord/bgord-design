    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/bun": "1.4.0",
    "cspell": "10.1.1",
    "fallow": "3.21.0",
    "gzip-cli": "1.2.0",
    "lefthook": "2.1.12",
    "lightningcss-cli": "1.33.0",
    "lockfile-lint": "5.0.1",
    "postcss": "8.5.26",
    "publint": "0.3.24",
    "shellcheck": "4.1.0",
    "typescript": "7.0.2"
  }
}
